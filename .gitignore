# IDEs and editors
.vscode/
.idea/
.project
.settings/
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Heavy Assets (Originals)
# We exclude the raw_assets folder and all source image formats
raw_assets/
*.jpg
*.png
*.jpeg
*.PNG
*.JPG

# Only allow optimized webp, svg and favicons in the img folder
!img/
!img/*.webp
!img/*.svg
!img/favicon-*.png
!img/apple-touch-icon.png
!favicon.ico

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
