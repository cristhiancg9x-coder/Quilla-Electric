---
/**
 * @layout BrochureLayout.astro
 * @description Layout dedicado exclusivamente para la página del Brochure.
 * Contiene reglas CSS especiales para optimizar la impresión (@media print) a PDF.
 */
const { titulo } = Astro.props;
---

<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} | Quilla Electric</title>

    <!-- GOOGLE FONTS: MONTSERRAT -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- BOTÓN DE ACCIÓN FLOTANTE PARA DESCARGAR (SOLO PANTALLA) -->
    <div class="print-controls">
      <a href="/" class="btn-back">← Volver al Sitio</a>
      <button onclick="window.print()" class="btn-print">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 5px;">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        Descargar / Imprimir PDF
      </button>
    </div>

    <!-- CONTENEDOR PRINCIPAL DEL BROCHURE (A4) -->
    <main class="brochure-container">
      <slot />
    </main>

    <style is:global>
      /* RESET */
      * {
        box-sizing: border-box;
      }
      body {
        font-family: 'Montserrat', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f1f5f9; /* Fondo gris claro en pantalla */
        color: #0f172a;
      }

      /* CONTROLADORES SOLO PARA PANTALLA */
      .print-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 30px;
        background-color: #ffffff;
        color: #0f172a;
        position: sticky;
        top: 0;
        z-index: 1000;
        border-bottom: 1px solid #e2e8f0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
      }

      .btn-back {
        color: #0f172a;
        text-decoration: none;
        font-weight: 600;
      }
      .btn-back:hover {
        text-decoration: underline;
      }

      .btn-print {
        background-color: #ffd700;
        color: #0f172a;
        border: none;
        padding: 10px 20px;
        font-weight: 800;
        border-radius: 5px;
        cursor: pointer;
        transition: transform 0.2s;
        text-transform: uppercase;
        font-size: 0.9rem;
      }
      .btn-print:hover {
        transform: scale(1.05);
      }

      /* CONTENEDOR TIPO A4 EN PANTALLA */
      .brochure-container {
        width: 100%;
        max-width: 210mm; /* Tamaño A4 exacto */
        margin: 40px auto;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        min-height: 297mm;
        display: flex;
        flex-direction: column;
      }

      /* HOJAS INDIVIDUALES DENTRO DEL BROCHURE */
      .page {
        width: 100%;
        min-height: 297mm;
        padding: 20mm;
        page-break-after: always; /* Fuerzo salto de página */
        position: relative;
        overflow: hidden;
      }

      .page:last-child {
        page-break-after: auto;
      }

      /* --- MEDIA QUERIES PARA IMPRESIÓN (EL CORAZÓN DEL BROCHURE) --- */
      @media print {
        @page {
          size: A4;
          margin: 0; /* Sin márgenes del navegador (Header/Footer default) */
        }
        
        body {
          background-color: white !important; /* Forzar fondo blanco */
          margin: 0;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        /* Ocultar elementos de UI interactiva */
        .print-controls {
          display: none !important;
        }

        /* Remuevo la sombra del contenedor para la impresión */
        .brochure-container {
          margin: 0 !important;
          box-shadow: none !important;
          max-width: 100% !important;
          width: 210mm !important;
        }

        /* Forzar saltos de página precisos */
        .page {
          page-break-inside: avoid;
          page-break-after: always;
          width: 210mm !important;
          height: 297mm !important;
          padding: 20mm !important;
        }
        
        .no-break {
          page-break-inside: avoid; /* Para que las tarjetas de servicios no se corten a medias */
        }
      }
    </style>
  </body>
</html>
