---
import BrochureLayout from "../layouts/BrochureLayout.astro";
import { getCollection } from "astro:content";
import logoImg from "../assets/logo-main.png";
import { Image } from "astro:assets";

const servicios = await getCollection("servicios");
---
<BrochureLayout titulo="Brochure Corporativo">
  <!-- PAGE 1: PORTADA Y NOSOTROS -->
  <div class="page">
    <div class="cover-header">
      <Image src={logoImg} alt="Quilla Electric Logo" class="brochure-logo" width={150} />
      <h1>Brochure de Servicios Profesionales</h1>
      <p class="subtitle">Soluciones Eléctricas Seguras y Certificadas en Arequipa</p>
    </div>

    <div class="about-section">
      <h2>¿Quiénes Somos?</h2>
      <p>
        Somos <strong>Quilla Electric</strong>, líderes en ingeniería eléctrica y sistemas de seguridad. Especializados en brindar atención rápida y garantizada para hogares, comercios e industrias. Nuestro equipo está conformado por profesionales técnicos e ingenieros colegiados.
      </p>
    </div>
    
    <div class="benefits-grid">
      <div class="benefit-item">
        <span class="icon">⚡</span>
        <h4>Atención Rápida</h4>
        <p>Expertos en solucionar urgencias eléctricas al instante.</p>
      </div>
      <div class="benefit-item">
        <span class="icon">📜</span>
        <h4>Certificados INDECI</h4>
        <p>Firmados por ingenieros colegiados habilitados.</p>
      </div>
      <div class="benefit-item">
        <span class="icon">🛡️</span>
        <h4>Garantía Real</h4>
        <p>Respaldamos el 100% de nuestros trabajos ejecutados.</p>
      </div>
    </div>
  </div>

  <!-- PAGE 2: SERVICIOS -->
  <div class="page bg-light">
    <h2 class="section-title">Catálogo de Servicios</h2>
    <div class="services-grid">
      {servicios.map((servicio) => (
        <div class="service-card no-break">
          {servicio.data.image && (
            <div class="service-img-container">
              <Image src={servicio.data.image} alt={servicio.data.title} class={`service-img ${servicio.data.imageFit === 'contain' ? 'contain' : 'cover'}`} />
            </div>
          )}
          <div class="service-content">
            <h3>{servicio.data.title}</h3>
            <p>{servicio.data.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- PAGE 3: CONTACTO -->
  <div class="page contact-page">
    <div class="contact-box no-break">
      <h2>¿Listo para empezar tu proyecto?</h2>
      <p class="cta-text">Contáctanos hoy mismo para solicitar una visita técnica o cotización sin compromiso.</p>
      
      <div class="contact-details">
        <div class="contact-item">
          <strong>📞 Teléfono / WhatsApp:</strong>
          <span>+51 951 413 458</span>
        </div>
        <div class="contact-item">
          <strong>📧 Correo Electrónico:</strong>
          <span>quillaelectriccyt@gmail.com</span>
        </div>
        <div class="contact-item">
          <strong>📍 Cobertura Principal:</strong>
          <span>Cerro Colorado, Cayma, Yanahuara, Cercado, J.L.B y Rivero, Yura (y todo Arequipa).</span>
        </div>
      </div>
      
      <div class="footer-note">
        <p>www.quillaelectric.site</p>
      </div>
    </div>
  </div>
</BrochureLayout>

<style>
  /* PORTADA */
  .cover-header {
    text-align: center;
    padding: 40px 0;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 40px;
  }
  .brochure-logo {
    margin-bottom: 20px;
    height: auto;
  }
  .cover-header h1 {
    font-size: 2.5rem;
    color: #0f172a;
    margin-bottom: 10px;
  }
  .subtitle {
    font-size: 1.2rem;
    color: #64748b;
  }

  /* NOSOTROS */
  .about-section {
    margin-bottom: 40px;
  }
  .about-section h2 {
    color: #0f172a;
    border-left: 5px solid #ffd700;
    padding-left: 15px;
  }
  .about-section p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #334155;
  }

  /* BENEFICIOS */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .benefit-item {
    background: #f8fafc;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    text-align: center;
  }
  .benefit-item .icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 15px;
  }
  .benefit-item h4 {
    color: #0f172a;
    margin-bottom: 10px;
  }
  .benefit-item p {
    font-size: 0.9rem;
    color: #475569;
  }

  /* SERVICIOS */
  .bg-light {
    background-color: #f8fafc;
  }
  .section-title {
    text-align: center;
    color: #0f172a;
    font-size: 2rem;
    margin-bottom: 30px;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  
  .service-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  .service-img-container {
    width: 100%;
    height: 150px;
    background: #f1f5f9;
  }
  
  .service-img {
    width: 100%;
    height: 100%;
  }
  .cover {
    object-fit: cover;
  }
  .contain {
    object-fit: contain;
  }
  
  .service-content {
    padding: 20px;
  }
  
  .service-content h3 {
    color: #0f172a;
    margin-top: 0;
    margin-bottom: 10px;
    font-size: 1.1rem;
  }
  
  .service-content p {
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  /* CONTACTO */
  .contact-page {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8fafc;
    color: #0f172a;
  }
  
  .contact-box {
    background: white;
    color: #0f172a;
    padding: 50px;
    border-radius: 12px;
    width: 100%;
    max-width: 800px;
    text-align: center;
    border-top: 5px solid #ffd700;
    border: 1px solid #e2e8f0;
  }
  
  .contact-box h2 {
    color: #0f172a;
    font-size: 2rem;
    margin-bottom: 15px;
  }
  
  .cta-text {
    font-size: 1.2rem;
    color: #475569;
    margin-bottom: 40px;
  }
  
  .contact-details {
    text-align: left;
    background: #f8fafc;
    padding: 30px;
    border-radius: 8px;
  }
  
  .contact-item {
    margin-bottom: 20px;
    font-size: 1.1rem;
    display: flex;
    flex-direction: column;
  }
  
  .contact-item:last-child {
    margin-bottom: 0;
  }
  
  .contact-item strong {
    color: #0f172a;
    margin-bottom: 5px;
  }
  
  .footer-note {
    margin-top: 40px;
    font-weight: bold;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* MEDIA QUERIES PARA IMPRESIÓN ADICIONALES (Colores oscuros/claros) */
  @media print {
    .contact-page {
      background-color: white !important;
    }
    .contact-box {
      border: 1px solid #e2e8f0 !important;
      border-top: 5px solid #ffd700 !important;
    }
  }
</style>
