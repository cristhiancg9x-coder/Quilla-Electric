---
/**
 * @page Inicio (Index)
 * @description Página de aterrizaje (Landing Page) principal.
 * Estructura:
 * 1. Hero Section con imagen de fondo optimizada y CTA.
 * 2. Sección de Beneficios (por qué elegirnos).
 * 3. Galería de proyectos destacados.
 * 4. FAQ (Preguntas Frecuentes).
 */
// src/pages/index.astro
// IMPORTACIÓN DE COMPONENTES DE PÁGINA
import MainLayout from "../layouts/MainLayout.astro";
import Beneficios from "../components/Beneficios.astro"; // Sección de características clave
import Galeria from "../components/Galeria.astro"; // Carrusel o grilla de fotos
import Testimonios from "../components/Testimonios.astro";
import Preguntas from "../components/Preguntas.astro"; // Sección FAQ
import { getImage } from "astro:assets";
import heroImage from "../assets/fondo-pantalla.png";

// Optimización de la imagen de fondo
const optimizedHero = await getImage({ src: heroImage, format: "webp" });
const heroBgUrl = `url(${optimizedHero.src})`;
---

<!-- ENVUELTA DE LAYOUT PRINCIPAL -->
<MainLayout 
  titulo="Electricista en Arequipa" 
  descripcion="¿Buscas electricistas en Arequipa? Ofrecemos servicios eléctricos a domicilio e industriales. Instalación, pozos a tierra y emergencias 24h. ¡Llama al 951413458!"
>
  <!-- SECCIÓN HERO: La primera impresión del usuario -->
  <div class="hero" style={`--hero-bg: ${heroBgUrl}`}>
    <h1>⚡ Electricista en Arequipa</h1>
    <p class="subtitulo">
      Expertos en <strong>servicios eléctricos en Arequipa</strong> para empresas y hogares.
      Atendemos emergencias, cortocircuitos, instalación de tableros, cámaras de seguridad y certificación de pozos a tierra. Técnicos colegiados con garantía real.
    </p>

    <!-- BOTONES DE LLAMADA A LA ACCIÓN (CTA) -->
    <div class="botones">
      <a href="/contacto" class="btn-primary">Solicitar Cotización</a>
      <a href="/servicios" class="btn-secondary">Ver Servicios</a>
    </div>
  </div>

  <hr class="divisor" />

  <!-- SECCIONES DE CONTENIDO -->
  <Beneficios />

  <Galeria />
  <Testimonios />
  <Preguntas />
</MainLayout>

<style>
  /* Estilos solo para la portada */
  /* Estilos solo para la portada */
  .hero {
    text-align: center;
    padding: 3rem 1rem; /* ESPACIADO REDUCIDO PARA MÓVIL */
    min-height: 70vh; /* Se adapta mejor sin estirar la pantalla */
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centrado vertical */
    align-items: center; /* Centrado horizontal */

    /* FONDO NORDICO (Blanco con toques de imagen opacada) */
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.8) 50%, rgba(255, 255, 255, 0.4) 100%),
      var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    
    color: var(--text-main);
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
  }
  h1 {
    font-size: 2rem; /* MOBILE AJUSTADO */
    color: var(--text-main); 
    margin-bottom: 1.5rem;
    line-height: 1.2;
    text-shadow: none; /* Sin sombras en minimalismo */
    max-width: 900px;
  }
  .subtitulo {
    font-size: 1.1rem; /* MOBILE REDUCIDO */
    color: var(--text-muted); 
    max-width: 700px;
    margin: 0 auto 1.5rem auto; /* MENOR SEPARACIÓN */
    padding: 0 5px;
    font-weight: 500;
  }

  .botones {
    display: flex;
    flex-direction: column; /* MOBILE: Stacked buttons */
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  /* MEDIA QUERIES DESKTOP */
  @media (min-width: 768px) {
    .hero {
      padding: 6rem 0;
      min-height: 85vh;
    }
    h1 {
      font-size: 3.5rem;
    }
    .subtitulo {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
    }
    .botones {
      flex-direction: row;
    }
  }

  /* Nota: .btn-primary viene de MainLayout */

  .btn-secondary {
    background: transparent;
    color: var(--text-main);
    padding: 12px 25px;
    text-decoration: none;
    border-radius: 50px;
    border: 1px solid var(--text-main);
    font-weight: bold;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: var(--bg-surface);
    color: var(--text-main);
    transform: translateY(-2px);
    border-color: #64748b;
  }

  .divisor {
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin: 2rem 0;
  }
</style>
